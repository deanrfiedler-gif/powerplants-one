# Any file whose bytes are hashed must check out identically on every platform.
# Migration checksums, the UI baseline register and design source pins all
# compare raw bytes, so a CRLF rewrite on Windows reads as a changed file.
* text=auto
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.css text eol=lf
*.svg text eol=lf
docs/blueprints/projects-starter-visuals/*.pdf binary
docs/blueprints/projects-starter-visuals/r02/*.pdf binary
# ES-02 retained text evidence is fingerprinted in its artifact manifest.
docs/testing/evidence/es02-native-r01/*.txt text eol=lf
docs/testing/evidence/es02-native-r01/failed/*.txt text eol=lf
# ES-08 retained text evidence is fingerprinted in its artifact manifest.
docs/testing/evidence/es08-native-r01/*.txt text eol=lf
