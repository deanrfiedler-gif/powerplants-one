# Copy to .env.local. Synthetic, disposable, loopback only. No live credentials.
PPO_ENV=local-synthetic
PPO_EXPOSURE=loopback
PPO_IDENTITY=synthetic
# Optional: enable Carl's simulated assistant only in this full local-synthetic environment.
# PPO_ASSISTANT=on
PPO_PORT=3000
NEXT_TELEMETRY_DISABLED=1
# Replace <local-password> with the password for your disposable local role.
DATABASE_URL=postgresql://ppo_local:<local-password>@127.0.0.1:5432/ppo_synthetic
# Optional (ADR-0050): a Font Awesome Kit ID whose Kit draws the icons, such as abc1234567.
# The Kit must allow this address. Leave it unset to keep the local drawings.
# PPO_FONT_AWESOME_KIT=
# Optional: the browser address, 127.0.0.1 (the default) or localhost. Kits accept localhost but
# not 127.0.0.1, so choose localhost to see the Kit's icons and open http://localhost:3000.
# The browser and HTTP test suites expect 127.0.0.1, so leave this unset when running them.
# PPO_LOCAL_HOST=localhost
