    {
      "table_name": "estimate_versions",
      "conname": "estimate_cost_schema",
      "contype": "c",
      "definition": "CHECK ((cost_schema_version = ANY (ARRAY[1, 2])))"
    },
    {
      "table_name": "estimate_versions",
      "conname": "estimate_versions_check",
      "contype": "c",
      "definition": "CHECK ((((version = 1) AND (predecessor_id IS NULL)) OR ((version > 1) AND (predecessor_id IS NOT NULL))))"
    },
    {
      "table_name": "estimate_versions",
      "conname": "estimate_versions_check1",
      "contype": "c",
      "definition": "CHECK ((((jsonb_array_length(lines) = 0) AND (cost_total IS NULL) AND (sell_total IS NULL)) OR ((jsonb_array_length(lines) > 0) AND (cost_total IS NOT NULL) AND (sell_total IS NOT NULL) AND (cost_total >= (0)::numeric) AND (sell_total >= cost_total))))"
    },
    {
      "table_name": "estimate_versions",
      "conname": "estimate_versions_content_hash_check",
      "contype": "c",
      "definition": "CHECK ((content_hash ~ '^[a-f0-9]{64}$'::text))"
    },
    {
      "table_name": "estimate_versions",
      "conname": "estimate_versions_lines_check",
      "contype": "c",
      "definition": "CHECK (((jsonb_typeof(lines) = 'array'::text) AND (jsonb_array_length(lines) <= 100)))"
    },
    {
      "table_name": "estimate_versions",
      "conname": "estimate_versions_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "estimate_versions",
      "conname": "estimate_versions_policy_check",
      "contype": "c",
      "definition": "CHECK ((policy = 'SYN-EST-ARITHMETIC-01'::text))"
    },
    {
      "table_name": "estimate_versions",
      "conname": "estimate_versions_reason_check",
      "contype": "c",
      "definition": "CHECK (((length(btrim(reason)) >= 1) AND (length(btrim(reason)) <= 1000)))"
    },
    {
      "table_name": "estimate_versions",
